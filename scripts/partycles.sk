on load:
  set {partycles::active} to true
  set {partycles::loc} to the location (0, 0, 0) in world "world"
  set {partycles::type} to "end rod"
  set {partycles::counter} to 0
  set {partycles::iters} to 1
  set {partycles::speed} to 5
  set {partycles::follow} to "nobody"
  set {partycles::following} to false

every tick:
  if {partycles::following} is true:
    set {partycles::loc} to location of ({partycles::following} parsed as player)
  loop {partycles::iters} times:
    increase {partycles::counter} by {partycles::speed}
    if {partycles::active} is true:
      set {_p1x} to x position of {partycles::loc} + sin({partycles::counter})
      set {_p1y} to y position of {partycles::loc} + sin({partycles::counter}/5)
      set {_p1z} to z position of {partycles::loc} + cos({partycles::counter})
      set {_p1loc} to the location ({_p1x}, {_p1y}, {_p1z}) in world "world"

      set {_p2x} to x position of {partycles::loc} - sin({partycles::counter})
      set {_p2y} to y position of {partycles::loc} - sin({partycles::counter}/5)
      set {_p2z} to z position of {partycles::loc} - cos({partycles::counter})
      set {_p2loc} to the location ({_p2x}, {_p2y}, {_p2z}) in world "world"

      play 1 ({partycles::type} parsed as visual effect) at {_p1loc} 
      play 1 ({partycles::type} parsed as visual effect) at {_p2loc}
      # message "loc: %{partycles::loc}%, p1: %{_p1loc}%, p2: %{_p2loc}%" to offlineplayer("fwfy")

command /partycles [<text>] [<text>]:
  permission: skript.admin
  trigger:
    if arg-1 is "active":
      set {partycles::active} to (arg-2 parsed as boolean)
      message "&aActive set to &l%arg-2%&r&a."
    else if arg-1 is "bring":
      set {partycles::loc} to location of the player
      message "&aLocation updated."
    else if arg-1 is "type":
      set {partycles::type} to arg-2
      message "&aType set to &l%arg-2%&r&a."
    else if arg-1 is "iters":
      set {partycles::iters} to (arg-2 parsed as number)
      message "&aIterations set to &l%arg-2%&r&a."
    else if arg-1 is "speed":
      set {partycles::speed} to (arg-2 parsed as number)
      message "&aSpeed set to &l%arg-2%&r&a."
    else if arg-1 is "follow":
      if arg-2 is "off":
        set {partycles::following} to false
        message "&aNo longer following anybody."
      else:
        set {partycles::following} to true
        set {partycles::follow} to arg-2
        message "&aFollowing &l%arg-2%&r&a."
    else if arg-1 is "debug":
      message "&6&lCurrent Partycles State:"
      loop {partycles::*}:
        message "  &b- &a%loop-index%:&r %loop-value%"
    else:
      message "&cUnknown subcommand '%arg-1%'. Valid subcommands are: active (true/false), bring, type (particle name), iters (number), speed (number), follow (off OR playername)" to player
