on right click:
	if name of event-item contains "&6&l[&e&lVIP&6&l]":
		if player has permission "group.vip":
			if name of event-item is "&6&l[&e&lVIP&6&l]&6 Funny Stick":
				if type of event-block is grass block:
					set block at location of event-block to dirt
		else:
			message "&4yoy cant" to player
	if name of event-item contains "&5&l[&d&lRANK PASS&5&l]":
		set {_info::*} to split event-item's lore with delimeter ";"
		message {_info::*} to player
		remove event-itemstack

every 3 ticks:
	loop all players:
		if loop-player is holding an egg named "brian":
			if level of protection on loop-player's held item is 1:
				push loop-player up at speed 10
				wait 1 tick
				push loop-player down at speed 20
		if loop-player is holding an egg named "roger":
			if level of protection on loop-player's held item is 1:
				loop 75 times:
					play sound "entity.donkey.hurt" at loop-player

on shoot:
	if shooter is holding an egg named "&c&l[&e&rSPECIAL&c&l]&4 EGG OF TRUTH":
		execute console command "/minecraft:kill @e[type=egg]"
		execute console command "/bc &r%name of shooter% deployed the &4EGG OF TRUTH&r."
		execute console command "/difficulty hard"
		execute console command "/bc &cServer difficulty set to Hard."
		execute console command "/playsound minecraft:block.end_portal.spawn master @a 0 0 0 1"
	if shooter is holding a bow:
		if level of protection on shooter's held item is 12:
			force the shooter to ride the projectile

on consume of bread:
	if name of event-itemtype is "&6&l[&e&lVIP&6&l]&6 Long Bread":
		cancel event
		if player has permission "group.vip":
			add 2.5 to the player's food level
		else:
			remove -0.5 from the player's food level

on craft:
	loop 9 times:
		if slot loop-number of player's current inventory is diamond named "&fTEMU Diamond":
			cancel event

on damage by player:
	if attacker is holding a wooden sword named "&6&l[&e&lVIP&6&l]&6 Rod of Beating":
		if attacker has permission "group.vip":
			cancel event
			if type of victim is player:
				push victim up at speed 0.5
			else:
				push victim up at speed 3
		else:
			cancel event
			message "&4yoy cant" to attacker
	if attacker is holding a kelp named "&6&l[&e&lVIP&6&l]&6 Funny Kelp":
		if attacker has permission "group.vip":
			if block 1 under victim is air and type of victim player:
				cancel event
			else:
				push victim up at speed 0.25
				cancel event
	if attacker is holding a bone named "&6&l[&e&lVIP&6&l]&6 Deboner":
		if victim is a skeleton:
			set tool of victim to stick
			cancel event
