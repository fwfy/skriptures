command /spoon:
	permission: group.default
	trigger:
		loop 100 times:
			wait 1 tick
			set {_x} to the player's x coordinate + ((sin(loop-value) * 200)-100)
			set {_y} to the player's y coordinate
			set {_z} to the player's z coordinate + ((cos(loop-value) * 200)-100)
			set {_pos} to the location at ({_x}, {_y}, {_z})
			make the player look at vector from the player to {_pos}

command /hum <string> [<string>]:
	permission: group.admin
	trigger:
		if arg-1 is "bring":
			set {hum::loc} to location of the player
			message "&cIt has arrived." to player
		else if arg-1 is "speed":
			set {hum::speed} to (arg-2 parsed as num)
			message "&cThe Hum will play at speed %arg-2%." to player
		else if arg-1 is "noise":
			set {hum::noise} to arg-2
			message "&c???" to player
		else if arg-1 is "scale":
			set {hum::scale} to (arg-2 parsed as num)
			message "&cIt has been scaled to %arg-2%." to player
		else if arg-1 is "voices":
			set {hum::voices} to (arg-2 parsed as num)
			message "&cIt comes in %arg-2% parts." to player
		else if arg-1 is "on":
			set {hum::active} to true
			message "&cIt begins." to player
		else if arg-1 is "off":
			set {hum::active} to false
			message "&cIt ends." to player
		else if arg-1 is "debugme":
			set {hum::debugplayer} to player
			message "&6Current &4&lHUM&r&6 settings:"
			loop {hum::*}:
				message "&d%loop-index%:&r %loop-value%" to player
		else:
			message "&cIt does not understand." to player

command /verybigexplosiondonotrunthiscommandunlessyouwanttoobliterateeverythingwithina500mileradiusofyourself:
	permission: group.admin
	trigger:
		loop 10 times:
			wait 1 tick
			set {_x} to the player's x coordinate + ((sin(loop-value) * 20)-10)
			set {_y} to the player's y coordinate
			set {_z} to the player's z coordinate + ((cos(loop-value) * 20)-10)
			set {_pos} to the location at ({_x}, {_y}, {_z})
			create an explosion of force 100 at {_pos}

command /huevokill:
	permission: skript.admin
	trigger:
		set {_killed} to 0
		loop all skeletons:
			if loop-entity's name is "El Huevo":
				kill loop-entity
				add 1 to {_killed}
		message "&aDone! Killed &4&l%{_killed}%&r&a entities." to player

every 20 ticks:
	loop all skeletons:
		if loop-entity's name is "El Huevo":
			set {_lowest} to 500000
			set {_huevo} to loop-entity
			loop all players:
				set {_distance} to the distance between loop-player and {_huevo}
				if {_distance} is less than {_lowest}:
					set {_lowest} to {_distance}
			if {_lowest} is less than 50:
				apply infinite glowing 1 to {_huevo}
			else:
				remove glowing from {_huevo}

on chat:
	replace all "bruh" in message with "spoon"
	if message contains "flash":
		set {huevo::blink} to false
		wait 300 seconds
		set {huevo::blink} to true

on load:
	if {huevo::blink} is not set:
		set {huevo::blink} to true
	set {hum::loc} to the location (0, 0, 0) of the world "world"
	set {hum::active} to false
	set {hum::tick_counter} to 0
	set {hum::speed} to 1
	set {hum::scale} to 1
	set {hum::voices} to 2
	set {hum::noise} to "block.note_block.harp"

every tick:
	set {hum::tick_counter} to {hum::tick_counter}+{hum::speed}
	if {hum::active} is true:
		loop {hum::voices} times:
			set {_pitch} to {hum::scale}*(sin({hum::tick_counter}))+(loop-value/{hum::voices})
			play sound {hum::noise} with volume 0.5 with pitch {_pitch} from {hum::loc}
			if {hum::voices} is 1.8:
				message "&d&lPITCH: %{_pitch}%" to {hum::debugplayer}
		

every 10 ticks:
	if {huevo::blink} is true:
		execute the command "/team modify huevo color red"
		wait 5 ticks
		execute the command "/team modify huevo color dark_red"

on spawn of a skeleton:
	if random number from 0 to 100 is less than 10:
		wait 1 tick
		set tool of event-entity to 1 egg
		enchant event-entity's tool with knockback 10
		execute the command "/team join huevo @e[type=skeleton]"
		set name of event-entity to "El Huevo"
		wait 600 seconds
		kill event-entity

on drop:
	if event-item is an egg:
		wait 1 tick
		kill event-item entity
