on join:
  if player's name is "hyfehnated":
    set {_h} to the player
    while {_h} is connected:
      wait 1 second
      set {_txt} to "&6Radar:&r"
      loop all players:
        set {_name} to loop-player's name
        set {_first} to first character of {_name}
        set {_last} to last character of {_name}
        set {_spn} to "%{_first}%%{_last}%"
        if loop-player's gamemode is spectator:
          set {_spn} to "%{_spn}%&d&l!"
        else if loop-player's gamemode is creative:
          set {_spn} to "%{_spn}%&d&o!"
        set {_dist} to the distance between {_h} and loop-player
        if {_dist} is less than 50:
          set {_txt} to "%{_txt}%&4%{_spn}% "
        else if {_dist} is less than 125:
          set {_txt} to "%{_txt}%&c%{_spn}% "
        else if {_dist} is less than 250:
          set {_txt} to "%{_txt}%&e%{_spn}% "
        else if {_dist} is less than 500:
          set {_txt} to "%{_txt}%&2%{_spn}% "
        else:
          set {_txt} to "%{_txt}%&b%{_spn}% "
        send action bar {_txt} to {_h}
