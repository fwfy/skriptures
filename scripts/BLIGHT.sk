command /_ <string> <player>:
  permission: group.default
  trigger:
    if arg-1 is "BLIGHT":
      set {_t} to arg-2
      set {_p} to position of {_t}
      loop 60 times:
        wait 1 tick
        loop 3 times:
          play sound "block.note_block.harp" with volume 1 with pitch loop-value-1 from {_p}
        message "&e&l⚠️&4&lSERVER EXPLOSION IMMINENT&e&l⚠️" to {_t}
