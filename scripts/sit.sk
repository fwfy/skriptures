on rightclick on any stairs:
  spawn armor stand at location below event-block
  set metadata value "steed" of the last spawned entity to 1
  set metadata value "rider" of the last spawned entity to name of the player
  set ai of the last spawned entity to false
  set gravity of the last spawned entity to false
  make the last spawned entity invisible
  make the player ride the last spawned entity

every 10 ticks:
  loop all armor stands:
    if metadata value "steed" of loop-entity is 1:
      if player(metadata value "rider" of loop-entity) is not riding an armor stand:
        kill loop-entity
      if metadata value "rider" of loop-entity is not set:
        kill loop-entity
