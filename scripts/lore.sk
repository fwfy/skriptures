on drop:
	wait 1 second
	if name of event-item is "&a&kLORELORELORELORE":
		if block at location of event-dropped item is water:
			kill event-dropped item
			execute the command "/kit lorebook %event-player%"

on shoot:
	execute the command "/alog test %name of shooter% threw %tool of shooter%"
	if shooter is holding an ender eye named "&4Eye of Sovereignty":
		cancel event
