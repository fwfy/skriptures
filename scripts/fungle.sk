on damage of entity:
        if "%victim%" is "dropped diamond":
                if "%type of block at location of victim%" is "lava":
                        delete victim
                        loop 100 times:
                                wait 1 tick
                                set {_i} to loop-value
                                summon a baby villager:
                                        thrust the villager up at speed 10
                                        thrust the villager north at speed sin({_i}*10)/2
                                        thrust the villager west at speed cos({_i}*10)/2
