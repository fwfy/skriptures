every 10 ticks:
  loop all sheep:
    if loop-entity's name is "Yakob":
      # message "%metadata value "flying" of loop-entity%" to player("fwfy")
      if metadata value "flying" of loop-entity is 0:
        if random number from 1 to 100 is less than 5:
          set metadata value "flying" of loop-entity to 1
          spawn bat at loop-entity
          make loop-entity ride the last spawned entity
          make the last spawned entity invisible
          set metadata value "steed" of the last spawned entity to 1
      else if metadata value "flying" of loop-entity is less than 20:
        set metadata value "flying" of loop-entity to ((metadata value "flying" of loop-entity) + 1)
      else:
        if the block 3 under loop-entity is not air:
          kill the nearest bat to loop-entity
          set metadata value "flying" of loop-entity to 0

on damage of a sheep:
  if the victim's name is "Yakob":
    if metadata value "flying" of victim is greater than 0:
      cancel event

command /rsteed:
  permission: skript.admin
  trigger:
    loop all entities:
      if metadata value "steed" of loop-entity is 1:
        kill loop-entity

on damage:
  if metadata value "steed" of victim is 1:
    cancel event
