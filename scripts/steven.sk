on join:
  if {steven::leaderboard::%uuid of player%} is not set:
    set {steven::leaderboard::%uuid of player%} to 0

on death of a sheep:
  if victim's name is " Steven ":
    if attacker is a player:
      set {steven::leaderboard::%uuid of attacker%} to {steven::leaderboard::%uuid of attacker%} + 1
      execute the command "/alog steven %name of attacker% just murdered a Steven! (%{steven::leaderboard::%uuid of attacker%}% total kills)"
    else:
      execute the command "/alog steven A Steven just died of a natural cause!"
    wait 3 seconds
    spawn a sheep at position of victim
    set name of the last spawned entity to " Steven "

command /clearstevenboard:
  permission: group.owner
  trigger:
    clear {steven::leaderboard::*}
    set {steven::leaderboard::%uuid of player%} to 0

command /stevenboard:
  permission: skript.admin
  trigger:
    # sort {steven::leaderboard::*}
    message "&aSteven Kill Leaderboard:" to player
    loop {steven::leaderboard::*}:
      set {_uuid} to loop-index
      set {_kills} to {steven::leaderboard::%{_uuid}%}
      set {_username} to name of offlineplayer({_uuid}) # Convert UUID to username
      message "- &e%{_username}%: &c%{_kills}% kills." to player
