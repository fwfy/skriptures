on damage of entity:
        if "%victim%" is "dropped diamond":
                if "%type of block at location of victim%" is "fire":
                        delete victim
                        play sound "block.amethyst_block.resonate" with volume 10
                        set weather to clear
                else if "%type of block at location of victim%" is "soul fire":
                        delete victim
                        play sound "block.amethyst_block.resonate" with volume 10
                        set weather to rainy
