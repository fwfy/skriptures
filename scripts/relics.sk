# Stick of Sadness
# suggested by Kenopsia

on right click:
  if the player is holding a stick:
    if name of the player's tool is "&6Stick of Sadness":
      loop all mobs:
        if loop-entity isn't a monster:
          if distance between loop-entity and the player is less than 20:
            set {_v} to vector between loop-entity and the player
            set {_vM} to vector(-1,1,-1)
            set {_v} to {_v} ** {_vM}
            set {_goal} to location of {_v}
            message {_goal} to the player
