# /glint command, to make relics look *Awesome*
command /glint:
  permission: skript.admin
  trigger:
    make player's tool start glinting

# And naturally, the antivenom.
command /unglint:
  permission: skript.admin
  trigger:
    make player's tool stop glinting

# Stick of Sadness
# suggested by Kenopsia !

every 1 seconds:
  loop all players:
    if loop-player is holding a stick:
      if name of loop-player's tool is "&6Stick of Sadness":
        loop all mobs:
          if loop-entity-2 isn't a monster or name of loop-player-1 is "fwfy":
            if distance between loop-entity-2 and loop-player-1 is less than 20:
              set {_loc} to location of loop-entity-2
              set {_v} to vector between loop-entity-2 and loop-player-1
              set {_vM} to vector -5, 0, -5
              set {_v} to {_v}*{_vM}
              set {_goal} to {_loc} ~ {_v}
              make loop-entity-2 pathfind towards {_goal}

# Long Tongs
# just for funsies

every 2 ticks:
  loop all players:
    if loop-player is holding a blaze rod:
      if name of loop-player's tool is "&6Long Tongs":
        if loop-player is sneaking:
          set {_target} to loop-player's targeted entity
          if {_target} is set:
            set {grabbed.%loop-player%} to {_target}
    
    if {grabbed.%loop-player%} is set:
      set {_target} to {grabbed.%loop-player%}
      if {_target} is not dead:
        set {_loc} to location of loop-player
        set {_dir} to (facing of loop-player)
        set {_point} to {_loc} + {_dir}
        set {_v} to vector from location of {_target} to {_point}
        set {_v} to {_v} * 0.4
        push {_target} {_v}
      else:
        delete {grabbed.%loop-player%}

# Lifeseer
# suggested by Nobody, i just felt like it lol
 
every 5 ticks:
  loop all players:
    if loop-player is holding an emerald:
      if name of loop-player's tool is "&6Lifeseer's Stone":
        if loop-player-1 is sneaking:
          set {_id} to uuid of loop-player
          # Cooldown check
          if {lifeseer::%{_id}%} is not set:
            set {lifeseer::%{_id}%} to 20
          set {lifeseer::%{_id}%} to {lifeseer::%{_id}%} - 1
          if {lifeseer::%{_id}%} < 0:
            # remove nausea from potion effects of loop-player
            apply nausea 1 without particles to loop-player for 5 seconds replacing the existing effect
            # send action bar "&8The Lifeseer's Stone dims..." to loop-player
            stop
          loop all mobs:
            if distance between loop-entity-2 and loop-player-1 is less than 20:
              set {_loc} to location of loop-entity-2
              set {_max} to the max health of loop-entity-2
              set {_health} to the health of loop-entity-2
              set {_dir} to normalized vector from {_loc} to loop-player
              set y component of {_dir} to 0
              set {_side} to ({_dir} cross vector(0, 1, 0))*-1
              set {_i} to ({_max}/2)*-1
              while {_i} < {_max}:
                set {_offset} to {_side}*({_i} / 5)
                add 2 to y component of {_offset}
                set {_pos} to {_loc} ~ {_offset}
                if {_i} < {_health}:
                  play 1 lime dust at {_pos}
                else:
                  play 1 red dust at {_pos}
                add 1 to {_i}
        else:
          set {lifeseer::%uuid of loop-player%} to {lifeseer::%uuid of loop-player%} + 2
          if {lifeseer::%uuid of loop-player%} > 40:
            delete {lifeseer::%uuid of loop-player%}


